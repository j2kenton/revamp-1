# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# Azure AD / MSAL Configuration
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Google Identity Services (Sign in with Google)
# Create an OAuth 2.0 Web client in Google Cloud Console configured for
# "callback" mode (no redirect URIs needed) and register your dev/staging/
# production origins as Authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ⚠️ SECURITY WARNING: Test Authentication Mode
# NEVER enable these in production unless for controlled testing
# These flags bypass real authentication for E2E tests
NEXT_PUBLIC_TEST_AUTH_MODE=false  # Set to 'true' ONLY for test environments
BYPASS_AUTH=false                  # Server-side bypass flag (development only)
NEXT_PUBLIC_BYPASS_AUTH=false      # Client-side bypass flag (development only)

# Environment
NODE_ENV=development  # 'development' | 'test' | 'production'
